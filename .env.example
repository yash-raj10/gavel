# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=judgment_memory

# No API keys needed for FalkorDB/laya/embeddings — those run fully local.
# agent.py's planning step is LLM-only and requires this (free key from console.groq.com/keys):
GROQ_API_KEY=

# Optional: only needed to run jira_sync.py (pull real tickets from Jira
# instead of using seed.py's demo data). Get a token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
